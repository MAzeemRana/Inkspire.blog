# --- Database ---
# Sandbox/development (SQLite). For Vercel production use Postgres (Neon/Supabase):
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# --- Public site URL (used for SEO: metadataBase, canonical, sitemap.xml, robots.txt, RSS) ---
# Set this to your production domain on Vercel, e.g. https://yourblog.vercel.app or https://yourdomain.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Admin auth ---
# Secret used to sign the admin session cookie (generate: openssl rand -base64 32)
AUTH_SECRET="change-me-in-production"
